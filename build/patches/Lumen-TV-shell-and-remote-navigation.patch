diff --git a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
index 8a679c1..24edb43 100644
--- a/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
+++ b/chrome/android/java/src/org/chromium/chrome/browser/ChromeTabbedActivity.java
@@ -3094,6 +3094,11 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
     @Override
     public void performPreInflationStartup() {
         super.performPreInflationStartup();
+        if (isTelevisionDevice()) {
+            // Blink's spatial navigation lets a D-pad move between links and controls in pages.
+            CommandLine.getInstance().appendSwitch("enable-spatial-navigation");
+            getWindow().setSoftInputMode(WindowManager.LayoutParams.SOFT_INPUT_STATE_ALWAYS_HIDDEN);
+        }
         mAcceleratorManager = AcceleratorManager.getOrCreate(getWindowAndroid());
 
         if (isMainIntentLaunchPreOnResume()) {
@@ -4927,6 +4932,8 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
 
     @Override
     public boolean dispatchKeyEvent(KeyEvent event) {
+        if (moveTelevisionFocus(event)) return true;
+
         Boolean result =
                 KeyboardShortcuts.dispatchKeyEvent(
                         event,
@@ -4953,6 +4960,43 @@ public class ChromeTabbedActivity extends ChromeActivity implements PreAttachInt
         return result != null ? result : super.dispatchKeyEvent(event);
     }
 
+    private boolean isTelevisionDevice() {
+        return (getResources().getConfiguration().uiMode & Configuration.UI_MODE_TYPE_MASK)
+                == Configuration.UI_MODE_TYPE_TELEVISION;
+    }
+
+    private boolean moveTelevisionFocus(KeyEvent event) {
+        if (!isTelevisionDevice()
+                || event.getAction() != KeyEvent.ACTION_DOWN
+                || event.getRepeatCount() != 0) {
+            return false;
+        }
+
+        int direction;
+        switch (event.getKeyCode()) {
+            case KeyEvent.KEYCODE_DPAD_UP:
+                direction = View.FOCUS_UP;
+                break;
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+                direction = View.FOCUS_DOWN;
+                break;
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+                direction = View.FOCUS_LEFT;
+                break;
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                direction = View.FOCUS_RIGHT;
+                break;
+            default:
+                return false;
+        }
+
+        View current = getCurrentFocus();
+        if (current == null || current.onCheckIsTextEditor()) return false;
+
+        View next = current.focusSearch(direction);
+        return next != null && next != current && next.requestFocus(direction);
+    }
+
     @Override
     public boolean onKeyDown(int keyCode, KeyEvent event) {
         if (!mUiWithNativeInitialized) {
